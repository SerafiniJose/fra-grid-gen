    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# voila starts the kernel with cwd = notebook dir; make `import component` resolvable\n",
    "root = str(Path.cwd())\n",
    "if root not in sys.path:\n",
    "    sys.path.insert(0, root)\n",
    "\n",
    "from app import Page\n",
    "\n",
    "element = Page()\n",
    "display(element)"
   ]
  }
